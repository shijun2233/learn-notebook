@inproceedings{dudnikov_polarized_2015,
	location = {Garching, Germany},
	title = {Polarized 3He− ion source with hyperfine state selection},
	url = {https://pubs.aip.org/aip/acp/article/584225},
	doi = {10.1063/1.4916486},
	abstract = {High beam polarization is essential to the scientific productivity of a collider. Polarized 3He ions are an essential part of the nuclear physics programs at existing and future ion-ion and electron-ion colliders such as {BNL}’s {RHIC} and {eRHIC} and {JLab}’s {ELIC}. Ion sources with performance exceeding that achieved today are a key requirement for the development of these next generation high-luminosity high-polarization colliders. The development of high-intensity high-brightness arc-discharge ion sources at the Budker Institute of Nuclear Physics ({BINP}) has opened up an opportunity for realization of a new type of a polarized 3Heí ion source. This report discusses a polarized 3Heí ion source based on the large difference of extra-electron autodetachment lifetimes of the different 3Heí ion hyperfine states. The highest momentum state of 5/2 has the largest lifetime of Ĳ {\textasciitilde} 3 ȝV {ZKLOH} {WKH} {ORZHU} {PRPHQWXP} {VWDWHV} {KDYH} {OLIHWLPHV} {RI} Ĳ a ȝV \%{\textbackslash} {SURGXFLQJ} 3Heí ion beam composed of only the {\textbar}5/2, r5/2{\textgreater} hyperfine states and then quenching one of the states by an {RF} resonant field, 3Heí beam polarization of 90\% can be achieved. Such a method of polarized 3Heí production has been considered before; however, due to low intensities of the He+ ion sources existing at that time, it was not possible to produce any interesting intensity of polarized 3Heí ions. The high-brightness arc-discharge ion source developed at {BINP} can produce a high-brightness 3He+ beam with an intensity of up to 2 A allowing for selection of up to {\textasciitilde}1-4 {mA} of 3Heí ions with {\textasciitilde} 90\% polarization. The high gas efficiency of an arc-discharge source is important due to the high cost of 3He gas. Some features of such a {PIS} as well as prototype designs are considered. An integrated 3Heí ion source design providing high beam polarization could be prepared using existing {BNL} equipment with incorporation of new designs of the 1) arc discharge plasma generator, 2) extraction system, 3) charge exchange jet, and 4) magnetic separation system.},
	eventtitle = {{FOURTH} {INTERNATIONAL} {SYMPOSIUM} {ON} {NEGATIVE} {IONS}, {BEAMS} {AND} {SOURCES} ({NIBS} 2014)},
	pages = {070006},
	author = {Dudnikov, V. and Morozov, V. and Dudnikov, A.},
	urldate = {2025-10-20},
	date = {2015},
	langid = {english},
	file = {Dudnikov 等 - 2015 - Polarized 3He− ion source with hyperfine state selection.pdf:F\:\\zetoro\\storage\\Y8IE4R52\\Dudnikov 等 - 2015 - Polarized 3He− ion source with hyperfine state selection.pdf:application/pdf},
}

