@article{levy_polarized_1998,
	title = {Polarized ion sources for high-energy accelerators (invited)},
	volume = {69},
	issn = {0034-6748, 1089-7623},
	url = {https://pubs.aip.org/rsi/article/69/2/732/1072567/Polarized-ion-sources-for-high-energy-accelerators},
	doi = {10.1063/1.1148609},
	abstract = {Motivated by experimental requirements at high energy accelerators, very large increases in polarized H− ion source current have been achieved recently. Polarized H− current of 1 {mA} dc from the optically pumped source ({OPPIS}) and 1 {mA} pulsed H− current from the atomic beam source ({ABS}) have been demonstrated. High current development of both the {ABS} and {OPPIS} is continuing. Pulsed current of more than 10 {mA} has been proven to be feasible from the {OPPIS}. An {OPPIS} is also used in the high precision parity violation experiment at {TRIUMF}, in which helicity-correlated changes to beam properties must be extremely small.},
	pages = {732--736},
