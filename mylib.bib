	urldate = {2025-06-30},
	date = {2009},
	langid = {english},
	file = {Nass 等 - 2009 - Studies on beam formation in an atomic beam source.pdf:F\:\\zetoro\\storage\\E2X5HQN3\\Nass 等 - 2009 - Studies on beam formation in an atomic beam source.pdf:application/pdf},
}

