	file = {已提交版本:F\:\\zetoro\\storage\\YRS6CCG7\\Larsen 等 - 2017 - Low-energy enhancement and fluctuations of γ-ray strength functions in 56,57Fe test of the Brink–Ax.pdf:application/pdf},
