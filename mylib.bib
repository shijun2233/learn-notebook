@article{sieja_brink-axel_2023,
	title = {Brink-Axel hypothesis in the pygmy-dipole resonance region},
	volume = {59},
	issn = {1434-601X},
	url = {https://link.springer.com/10.1140/epja/s10050-023-01067-8},
	doi = {10.1140/epja/s10050-023-01067-8},
	abstract = {The Brink–Axel hypothesis, which states that the photoabsorption cross section is independent of the excitation energy of a nuclear system, is an assumption used in nuclear structure studies and calculations of neutron-capture cross section for astrophysical applications. In the present work, using microscopic Conﬁguration Interaction method, it is demonstrated that the dipole photoabsorption cross section at low energy is dependent on the excitation energy and deviations from the Brink-Axel hypothesis are particularily large for the ground state of an even-even system. It is also shown that the low-lying E1-strength, known as pygmy dipole resonance, is redistributed with the excitation energy of the initial state and strongly dependent on its structure. The consequences of these ﬁndings on the calculated neutron-capture cross sections are discussed.},
	pages = {147},
	number = {7},
	journaltitle = {The European Physical Journal A},
	shortjournal = {Eur. Phys. J. A},
	author = {Sieja, K.},
	urldate = {2024-11-10},
	date = {2023-07-05},
	langid = {english},
	file = {PDF:F\:\\zetoro\\storage\\876V9TK7\\Sieja - 2023 - Brink-Axel hypothesis in the pygmy-dipole resonance region.pdf:application/pdf},
}

