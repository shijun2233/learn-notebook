	url = {https://pubs.aip.org/jcp/article/129/8/084312/984736/Preparation-of-oriented-and-aligned-H2-and-HD-by},
	doi = {10.1063/1.2973628},
	abstract = {Stimulated Raman pumping has been used to prepare oriented and aligned samples of H2(ν=1,J=1,2,3) and {HD}(ν=1,J=2) under collision-free conditions using the (1,0) S(0), S(1), Q(1), Q(2), and O(3) lines. The M-sublevel anisotropies were interrogated by polarized [2+1] resonance-enhanced multiphoton ionization via the (0,1) O(2), O(3), and S(1) lines of the E,{FΣg}+1−{XΣg}+1 system. The optical excitation schemes employed in this study generate highly oriented and aligned molecular ensembles. We show that the H2(ν=1,J=2,M=0) and H2(ν=1,J=2,M=2) samples retain their initial polarization for greater than 100ns and are therefore suitable candidates for targets or projectiles in future scattering experiments.},
	pages = {084312},
	number = {8},
	journaltitle = {The Journal of Chemical Physics},
	author = {Bartlett, Nate C. M. and Miller, Daniel J. and Zare, Richard N. and Sofikitis, Dimitris and Peter Rakitzis, T. and Alexander, Andrew J.},
	urldate = {2025-09-28},
