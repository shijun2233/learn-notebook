	keywords = {Nuclear Theory, Nuclear Experiment},
	file = {Preprint PDF:F\:\\zetoro\\storage\\WKS7U3PK\\Saha 等 - 2024 - Proton induced reaction on \$^ 108 \$Cd for astrophysical p-process studies.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\XG829HGV\\2411.html:text/html},
