@article{luo_simulation_2024,
	title = {Simulation study of intra-beam scattering effect in the {HALF} storage ring with piwinski model},
	volume = {8},
	issn = {2509-9930, 2509-9949},
	url = {https://link.springer.com/10.1007/s41605-024-00472-x},
	doi = {10.1007/s41605-024-00472-x},
	abstract = {Background The Hefei Advanced Light Facility ({HALF}) will be a {VUV} and soft X-ray diffraction-limited storage ring ({DLSR}), and its high density of electron bunches makes the intra-beam scattering ({IBS}) effect very serious. Methods An {IBS} module used in the {IMPACT} code is developed, where the scattering process of {IBS} is described by the Piwinski model in Monte Carlo sampling. In the {IMPACT} code with {IBS} module, the macroparticle beam in storage ring is numerically tracked, including motion under external electromagnetic field and the {IBS} scattering process. And the longterm tracking results of macroparticle beam are statistically analyzed.},
