	file = {Snapshot:F\:\\zetoro\\storage\\AZUUJG93\\2310.html:text/html;Zheng 等 - 2024 - Preservation of \$^3mkern-2mu\$he ion polarization after laser-plasma acceleration.pdf:F\:\\zetoro\\storage\\IAISKGHC\\Zheng 等 - 2024 - Preservation of \$^3mkern-2mu\$he ion polarization after laser-plasma acceleration.pdf:application/pdf},
