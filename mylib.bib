	abstract = {We report high steady-state nuclear polarization of 1torr 3He gas nuclei via metastability exchange optical pumping at magnetic fields above 2T. The introduction of highly polarized 3He gas into Brookhaven’s Electron Beam Ion Source would enable a new, polarized 3He ion source for use at the Relativistic Heavy Ion Collider and a future Electron–Ion Collider facility. By adapting recent developments in high field metastability exchange optical pumping for higher pressure gas, we have successfully polarized 1torr 3He sealed cells in the {EBIS} solenoid. Through careful manipulation of the {RF} discharge parameters, polarizations above 80\% were attained at 2, 3 and 4T, with 89\% being reached at 3T with a 664s relaxation time.},
	pages = {161892},
	journaltitle = {Nuclear Instruments and Methods in Physics Research Section A: Accelerators, Spectrometers, Detectors and Associated Equipment},
	shortjournal = {Nuclear Instruments and Methods in Physics Research Section A: Accelerators, Spectrometers, Detectors and Associated Equipment},
	author = {Maxwell, J. D. and Alessi, J. and Atoian, G. and Beebe, E. and Epstein, C. S. and Milner, R. G. and Musgrave, M. and Pikin, A. and Ritter, J. and Zelenski, A.},
	urldate = {2025-09-28},
	date = {2020-04-11},
	keywords = {He polarization, High magnetic field, Metastability exchange optical pumping},
	file = {Maxwell 等 - 2020 - Enhanced polarization of low pressure 3.pdf:F\:\\zetoro\\storage\\V2DMHAMQ\\Maxwell 等 - 2020 - Enhanced polarization of low pressure 3.pdf:application/pdf;ScienceDirect Snapshot:F\:\\zetoro\\storage\\NMFERPXW\\S0168900219301949.html:text/html},
