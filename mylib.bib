	eprinttype = {arxiv},
	eprint = {2407.04403 [nucl-th]},
	keywords = {Nuclear Theory, Astrophysics - High Energy Astrophysical Phenomena},
	file = {Preprint PDF:F\:\\zetoro\\storage\\PFU3JN2P\\Boukari 等 - 2024 - Constraining the high-density behavior of nuclear symmetry energy with direct Urca processes.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\Z2JZL27V\\2407.html:text/html},
}

