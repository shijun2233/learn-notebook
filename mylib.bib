	keywords = {Nuclear Theory, Astrophysics - High Energy Astrophysical Phenomena},
	file = {Preprint PDF:F\:\\zetoro\\storage\\HE2LDHXD\\Taniguchi和Kimura - 2024 - Impact of the molecular resonances on the 12C+12C fusion reaction rate.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\RNEYRXYG\\2401.html:text/html},
}

