@misc{markova_nuclear_2023,
	title = {Nuclear level densities and \$γ-\$ray strength functions of \${\textasciicircum}\{111,112,113\}\$Sn isotopes studied with the Oslo method},
	url = {http://arxiv.org/abs/2311.08865},
	doi = {10.48550/arXiv.2311.08865},
	abstract = {The \${\textasciicircum}\{111,112,113\}\$Sn isotopes have been studied with (\$p,d {\textbackslash}gamma\$), (\$p,p{\textasciicircum}\{{\textbackslash}prime\} {\textbackslash}gamma\$), and (\$d,p {\textbackslash}gamma\$) reactions to extract the nuclear level densities ({NLDs}) and \${\textbackslash}gamma\$-ray strength functions ({GSFs}) of these nuclei below the neutron separation energy by means of the Oslo method. The experimental {NLDs} for all three nuclei demonstrate a trend compatible with the constant-temperature model below the neutron separation energy while also being in good agreement with the {NLDs} of neighboring Sn isotopes, obtained previously with the Oslo-type and neutron evaporation experiments. The extracted microcanonical entropies yield \${\textbackslash}approx 1.5\$ \$k\_B\$ entropy of a valence neutron in both \${\textasciicircum}\{111\}\$Sn and \${\textasciicircum}\{113\}\$Sn. Moreover, the deduced microcanonical temperatures indeed suggest a clear constant-temperature behavior above \${\textbackslash}approx\$ 3 {MeV} in \${\textasciicircum}\{111,113\}\$Sn and above \${\textbackslash}approx\$ 4.5 {MeV} in \${\textasciicircum}\{112\}\$Sn. We observe signatures for the first broken neutron pairs between 2 and 4 {MeV} in all three nuclei. The {GSFs} obtained with the Oslo method are found to be in good agreement below the neutron threshold with the strengths of \${\textasciicircum}\{112,114\}\$Sn extracted in the (\$p,p{\textasciicircum}\{{\textbackslash}prime\}\$) Coulomb excitation experiments.},
	number = {{arXiv}:2311.08865},
	publisher = {{arXiv}},
