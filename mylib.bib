@misc{engels_universal_2023,
	title = {A universal method to generate hyperpolarisation in beams and samples},
	url = {http://arxiv.org/abs/2311.05976},
	doi = {10.48550/arXiv.2311.05976},
	abstract = {Sizable hyperpolarisation, i.e. an imbalance of the occupation numbers of nuclear spins in a sample deviating from thermal equilibrium, is needed in various fields of science. For example, hyperpolarised tracers are utilised in magnetic resonance imaging in medicine ({MRI}) and polarised beams and targets are employed in nuclear physics to study the spin dependence of nuclear forces. Here we show that the quantum interference of transitions induced by radio-wave pumping with longitudinal and radial pulses are able to produce large polarisations at small magnetic fields. This method is easier than established methods, theoretically understood and experimentally proven for beams of metastable hydrogen atoms in the {keV} energy range. It should also work for a variety of samples at rest. Thus, this technique opens the door for a new generation of polarised tracers, possibly low-field {MRI} with better spatial resolution or the production of polarised fuel to increase the efficiency of fusion reactors by manipulating the involved cross sections.},
	number = {{arXiv}:2311.05976},
	publisher = {{arXiv}},
	author = {Engels, R. and El-Kordy, T. and Faatz, N. and Hanhart, C. and Hanold, N. and Kannis, C. S. and Kunkel, L. and Pütz, S. and Sharma, H. and Sefzick, T. and Soltner, H. and Verhoeven, V. and Westphal, M. and Wirtz, J. and Büscher, M.},
	urldate = {2025-10-20},
	date = {2023-11-10},
	eprinttype = {arxiv},
	eprint = {2311.05976 [physics]},
	keywords = {Physics - Accelerator Physics, Physics - Atomic Physics, Physics - Medical Physics, Quantum Physics},
	file = {Engels 等 - 2023 - A universal method to generate hyperpolarisation in beams and samples.pdf:F\:\\zetoro\\storage\\A99H855W\\Engels 等 - 2023 - A universal method to generate hyperpolarisation in beams and samples.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\WFSZ65R7\\2311.html:text/html},
}

@misc{zheng_preservation_2024,
	title = {Preservation of \${\textasciicircum}3{\textbackslash}mkern-2mu\$he ion polarization after laser-plasma acceleration},
	url = {http://arxiv.org/abs/2310.04184},
	doi = {10.48550/arXiv.2310.04184},
	abstract = {The preservation of nuclear spin alignment in plasmas is a prerequisite for important applications, such as energy production through polarized fusion or the acceleration of polarized particle beams. Although this conservation property has been the basis of numerous theoretical papers, it has never been experimentally confirmed. Here, we report on first experimental data from a polarized \${\textasciicircum}3{\textbackslash}mkern-2mu\$He target heated by a {PW} laser pulse, showing evidence for persistence of the nuclear polarization after acceleration to {MeV} energies. The finding also validates the concept of using pre-polarized targets for experiments at high-power laser facilities.},
	number = {{arXiv}:2310.04184},
	publisher = {{arXiv}},
	author = {Zheng, Chuan and Fedorets, Pavel and Engels, Ralf and Engin, Ilhan and Glückler, Harald and Kannis, Chrysovalantis and Schnitzler, Norbert and Soltner, Helmut and Chitgar, Zahra and Gibbon, Paul and Reichwein, Lars and Pukhov, Alexander and Zielbauer, Bernhard and Büscher, Markus},
	urldate = {2025-10-20},
