@article{disheng_research_nodate,
	title = {Research on plasma excitation and spectral collection based on high frequency pulse laser paint removal},
	abstract = {Laser paint stripping, due to its advantages such as high efficiency and controllability, is expected to be applied as a potential cleaning technology for aircraft skin paint layer cleaning. Since pulsed lasers can reduce substrate heat accumulation compared to continuous lasers, they can be applied to laser cleaning. Process and quality monitoring are essential means to achieve effective quality control. Laser-induced breakdown spectroscopy ({LIBS}) can monitor the changes in characteristic peaks of cleaning material elements, enabling high-frequency laser paint stripping process monitoring and feedback control. However, the peak power of highfrequency ({kHz}) lasers is relatively low compared to low-frequency (Hz) lasers, making it more difficult to excite plasma, thus affecting the effectiveness of {LIBS} monitoring. Therefore, it is necessary to study the excitation of plasma and the spectral acquisition effects of highfrequency pulsed laser paint stripping. The study uses Hz-level and {kHz}-level pulsed laser excitations to induce plasma in aircraft skin paint layers ({CA}7700 primer + {CA}8000 topcoat), and analyzes the excitation and acquisition effects through spectral peak intensity, number of peaks, and wavelength shift.},
	author = {Disheng, Wang and Wenfeng, Professor Yang},
	langid = {english},
	keywords = {⛔ No {DOI} found},
	file = {Disheng和Wenfeng - Research on plasma excitation and spectral collection based on high frequency pulse laser paint remo.pdf:F\:\\zetoro\\storage\\NYK7MRV2\\Disheng和Wenfeng - Research on plasma excitation and spectral collection based on high frequency pulse laser paint remo.pdf:application/pdf},
