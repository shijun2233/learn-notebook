}

@misc{puls_chemical_2024,
	title = {Chemical Evolution of R-process Elements in Stars ({CERES}): {IV}. An observational run-up of the third r-process peak with Hf, Os, Ir, and Pt},
	url = {http://arxiv.org/abs/2412.00195},
	doi = {10.48550/arXiv.2412.00195},
	shorttitle = {Chemical Evolution of R-process Elements in Stars ({CERES})},
	abstract = {The third r-process peak (Os, Ir, Pt) is poorly understood due to observational challenges, with spectral lines located in the blue or near-ultraviolet region of stellar spectra. These challenges need to be overcome for a better understanding of the r-process in a broader context. To understand how the abundances of the third r-process peak are synthesised and evolve in the Universe, a homogeneous chemical analysis of metal-poor stars using high quality data observed in the blue region of the electromagnetic spectrum ({\textless} 400 nm) is necessary. We provide a homogeneous set of abundances for the third r-process peak (Os, Ir, Pt) and Hf, increasing by up to one order of magnitude their availability in the literature. A classical 1D, local thermodynamic equilibrium ({LTE}) analysis of four elements (Hf, Os, Ir, Pt) is performed, using {ATLAS} model atmospheres to fit synthetic spectra in high resolution ({\textgreater} 40,000), high signal-to-noise ratio, of 52 red giants observed with {UVES}/{VLT}. Due to the heavy line blending involved, a careful determination of upper limits and uncertainties is done. The observational results are compared with state-of-the-art nucleosynthesis models. Our sample displays larger abundances of Ir (Z=77) in comparison to Os (Z=76), which have been measured in a few stars in the past. The results also suggest decoupling between abundances of third r-process peak elements with respect to Eu (rare earth element) in Eu-poor stars. This seems to contradict a co-production scenario of Eu and the third r-process peak elements Os, Ir, and Pt in the progenitors of these objects. Our results are challenging to explain from the nucleosynthetic point of view: the observationally derived abundances indicate the need for an additional early, primary formation channel (or a non-robust r-process).},
	number = {{arXiv}:2412.00195},
	publisher = {{arXiv}},
	author = {Puls, Arthur Alencastro and Kuske, Jan and Hansen, Camilla Juul and Lombardo, Linda and Visentin, Giorgio and Arcones, Almudena and Melo, Raphaela Fernandes de and Reichert, Moritz and Bonifacio, Piercarlo and Caffau, Elisabetta and Fritzsche, Stephan},
	urldate = {2024-12-09},
	date = {2024-11-29},
	eprinttype = {arxiv},
	eprint = {2412.00195 [astro-ph]},
	keywords = {Astrophysics - Solar and Stellar Astrophysics, Astrophysics - Astrophysics of Galaxies},
	file = {Preprint PDF:F\:\\zetoro\\storage\\RLXK2YKF\\Puls 等 - 2024 - Chemical Evolution of R-process Elements in Stars (CERES) IV. An observational run-up of the third.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\MY3A5NGN\\2412.html:text/html},
}

@misc{sheykhi_barrow_2024,
	title = {Barrow Cosmology and Big-Bang Nucleosynthesis},
	url = {http://arxiv.org/abs/2411.06075},
	doi = {10.48550/arXiv.2411.06075},
	abstract = {Using thermodynamics-gravity conjecture, we present the formal derivation of the modified Friedmann equations inspired by the Barrow entropy, \$S{\textbackslash}sim A {\textasciicircum}\{1+{\textbackslash}delta/2\}\$, where \$0{\textbackslash}leq{\textbackslash}delta{\textbackslash}leq 1\$ is the Barrow exponent and \$A\$ is the horizon area. We then constrain the exponent \${\textbackslash}delta\$ by using Big-Bang Nucleosynthesis ({BBN}) observational data. In order to impose the upper bound on the Barrow exponent \${\textbackslash}delta\$, we set the observational bound on \${\textbackslash}left{\textbar} {\textbackslash}frac\{{\textbackslash}delta T\_f\} \{T\_f \}{\textbackslash}right{\textbar}\$. We find out that the Barrow parameter \${\textbackslash}delta\$ should be around \$ {\textbackslash}delta {\textbackslash}simeq 0.01\$ in order not to spoil the {BBN} era. Next we derive the bound on the Barrow exponent \${\textbackslash}delta\$ in a different approach in which we analyze the effects of Barrow cosmology on the primordial abundances of light elements i.e. Helium \$\_\{\}{\textasciicircum}\{4\}{\textbackslash}textit\{He\}\$, Deuterium \$D\$ and Lithium \$\_\{\}{\textasciicircum}\{7\}{\textbackslash}textit\{Li\}\$. We observe that the deviation from standard Bekenstein-Hawking expression is small as expected. Additionally we present the relation between cosmic time \$t\$ and temperature \$T\$ in the context of modified Barrow cosmology. We confirm that the temperature of the early universe increases as the Barrow exponent \${\textbackslash}delta\$ (fractal structure of the horizon) increases, too.},
	number = {{arXiv}:2411.06075},
	publisher = {{arXiv}},
	author = {Sheykhi, Ahmad and Shahbazi, Ava},
	urldate = {2024-12-08},
	date = {2024-11-12},
	eprinttype = {arxiv},
	eprint = {2411.06075 [gr-qc]},
	keywords = {General Relativity and Quantum Cosmology, High Energy Physics - Theory},
	file = {Preprint PDF:F\:\\zetoro\\storage\\IKIAFZU6\\Sheykhi和Shahbazi - 2024 - Barrow Cosmology and Big-Bang Nucleosynthesis.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\YIKWWAJG\\2411.html:text/html},
}

@article{spyrou_enhanced_2024,
	title = {Enhanced production of 60Fe in massive stars},
	volume = {15},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-024-54040-4},
	doi = {10.1038/s41467-024-54040-4},
	abstract = {Massive stars are a major source of chemical elements in the cosmos, ejecting freshly produced nuclei through winds and core-collapse supernova explosions into the interstellar medium. Among the material ejected, long lived radioisotopes, such as 60Fe (iron) and 26Al (aluminum), offer unique signs of active nucleosynthesis in our galaxy. There is a long-standing discrepancy between the observed 60Fe/26Al ratio by γ-ray telescopes and predictions from supernova models. This discrepancy has been attributed to uncertainties in the nuclear reaction networks producing 60Fe, and one reaction in particular, the neutroncapture on 59Fe. Here we present experimental results that provide a strong constraint on this reaction. We use these results to show that the production of 60Fe in massive stars is higher than previously thought, further increasing the discrepancy between observed and predicted 60Fe/26Al ratios. The persisting discrepancy can therefore not be attributed to nuclear uncertainties, and points to issues in massive-star models.},
	pages = {9608},
	number = {1},
	journaltitle = {Nature Communications},
	shortjournal = {Nat Commun},
	author = {Spyrou, A. and Richman, D. and Couture, A. and Fields, C. E. and Liddick, S. N. and Childers, K. and Crider, B. P. and {DeYoung}, P. A. and Dombos, A. C. and Gastis, P. and Guttormsen, M. and Hermansen, K. and Larsen, A. C. and Lewis, R. and Lyons, S. and Midtbø, J. E. and Mosby, S. and Muecher, D. and Naqvi, F. and Palmisano-Kyle, A. and Perdikakis, G. and Prokop, C. and Schatz, H. and Smith, M. K. and Sumithrarachchi, C. and Sweet, A.},
	urldate = {2024-12-08},
	date = {2024-11-07},
	langid = {english},
	file = {PDF:F\:\\zetoro\\storage\\AFM7W9HH\\Spyrou 等 - 2024 - Enhanced production of 60Fe in massive stars.pdf:application/pdf},
}

