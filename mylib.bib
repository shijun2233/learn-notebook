@misc{martin_test_2017,
	title = {Test of the Brink-Axel hypothesis for the pygmy dipole resonance},
	url = {http://arxiv.org/abs/1611.01789},
	doi = {10.48550/arXiv.1611.01789},
	abstract = {The gamma strength function and level density of 1- states in 96Mo have been extracted from a high-resolution study of the (p,p') reaction at 295 {MeV} and extreme forward angles. By comparison with compound nucleus \${\textbackslash}gamma\$ decay experiments, this allows a test of the generalized Brink-Axel hypothesis in the energy region of the Pygmy Dipole Resonance. The Brink-Axel hypothesis is commonly assumed in astrophysical reaction network calculations and states that the gamma strength function in nuclei is independent of the structure of initial and final state. The present results validiate the Brink-Axel hypothesis for 96Mo and provide independent confirmation of the methods used to separate gamma strength function and level density in \${\textbackslash}gamma\$ decay experiments.},
	number = {{arXiv}:1611.01789},
	publisher = {{arXiv}},
	author = {Martin, D. and Neumann-Cosel, P. von and Tamii, A. and Aoi, N. and Bassauer, S. and Bertulani, C. A. and Carter, J. and Donaldson, L. and Fujita, H. and Fujita, Y. and Hashimoto, T. and Hatanaka, K. and Ito, T. and Krugmann, A. and Liu, B. and Maeda, Y. and Miki, K. and Neveling, R. and Pietralla, N. and Poltoratska, I. and Ponomarev, V. Yu and Richter, A. and Shima, T. and Yamamoto, T. and Zweidinger, M.},
	urldate = {2024-11-12},
	date = {2017-10-20},
	eprinttype = {arxiv},
	eprint = {1611.01789},
	keywords = {Nuclear Experiment},
	file = {Preprint PDF:F\:\\zetoro\\storage\\N2NLQA6I\\Martin 等 - 2017 - Test of the Brink-Axel hypothesis for the pygmy dipole resonance.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\MQYJ6L33\\1611.html:text/html},
}

@misc{markova_comprehensive_2021-1,
	title = {Comprehensive test of the Brink-Axel hypothesis in the energy region of the pygmy dipole resonance},
	url = {http://arxiv.org/abs/2012.11956},
	doi = {10.48550/arXiv.2012.11956},
	abstract = {The validity of the Brink-Axel hypothesis, which is especially important for numerous astrophysical calculations, is addressed for 116,120,124Sn below the neutron separation energy by means of three independent experimental methods. The \${\textbackslash}gamma\$-ray strength functions ({GSFs}) extracted from primary \${\textbackslash}gamma\$-decay spectra following charged-particle reactions with the Oslo method and with the Shape method demonstrate excellent agreement with those deduced from forward-angle inelastic proton scattering at relativistic beam energies. In addition, the {GSFs} are shown to be independent of excitation energies and spins of the initial and final states. The results provide a critical test of the generalized Brink-Axel hypothesis in heavy nuclei, demonstrating its applicability in the energy region of the pygmy dipole resonance.},
	number = {{arXiv}:2012.11956},
	publisher = {{arXiv}},
	author = {Markova, M. and Neumann-Cosel, P. von and Larsen, A. C. and Bassauer, S. and Görgen, A. and Guttormsen, M. and Garrote, F. L. Bello and Berg, H. C. and Bjørøen, M. M. and Dahl-Jacobsen, T. and Eriksen, T. K. and Gjestvang, D. and Isaak, J. and Mbabane, M. and Paulsen, W. and Pedersen, L. G. and Pettersen, N. I. J. and Richter, A. and Sahin, E. and Scholz, P. and Siem, S. and Tveten, G. M. and Valsdottir, V. M. and Wiedeking, M. and Zeiser, F.},
	urldate = {2024-11-12},
	date = {2021-10-04},
	eprinttype = {arxiv},
	eprint = {2012.11956},
	keywords = {Nuclear Theory, Nuclear Experiment},
	file = {Preprint PDF:F\:\\zetoro\\storage\\IEPJUE27\\Markova 等 - 2021 - Comprehensive test of the Brink-Axel hypothesis in the energy region of the pygmy dipole resonance.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\J4Z3959E\\2012.html:text/html},
}

@misc{bassauer_gamma_2016,
	title = {Gamma strength function and level density of \${\textasciicircum}\{208\}\$Pb from forward-angle proton scattering at 295 {MeV}},
	url = {http://arxiv.org/abs/1609.00937},
	doi = {10.48550/arXiv.1609.00937},
	abstract = {Gamma strength functions ({GSFs}) and level densities ({LDs}) are essential ingredients of statistical nuclear reaction theory with many applications in astrophysics, reactor design, and waste transmutation. The aim of the present work is a test of systematic parametrizations of the {GSF} recommended by the {RIPL}-3 data base for the case of \${\textasciicircum}\{208\}\$Pb. The upward {GSF} and {LD} in \${\textasciicircum}\{208\}\$Pb are compared to gamma decay data from an Oslo-type experiment to examine the validity of the Brink-Axel ({BA}) hypothesis. The E1 and M1 parts of the total {GSF} are determined from high-resolution forward angle inelastic proton scattering data taken at 295 {MeV} at {RCNP}, Osaka, Japan. The total {LD} in \${\textasciicircum}\{208\}\$Pb is derived from the \$1{\textasciicircum}-\$ {LD} extracted with a fluctuation analysis in the energy region of the isovector giant dipole resonance. The E1 {GSF} is compared to parametrizations recommended by the {RIPL}-3 data base showing systematic deficiencies of all models in the energy region around neutron threshold. The new data for the poorly known spinflip M1 resonance call for a substantial revision of the model suggested in {RIPL}-3. The total {GSF} derived from the present data is larger in the {PDR} energy region than the Oslo data but the strong fluctuations due to the low {LD} resulting from the double shell closure of \${\textasciicircum}\{208\}\$Pb prevent a conclusion on a possible violation of the {BA} hypothesis. Using the parameters suggested by {RIPL}-3 for a description of the {LD} in \${\textasciicircum}\{208\}\$Pb with the back-shifted Fermi gas model, remarkable agreement between the two experiments spanning a wide excitation energy range is obtained. Systematic parametrizations of the E1 and M1 {GSF} parts need to be reconsidered at low excitation energies. The good agreement of {LD} provides an independent confirmation of the approach underlying the decomposition of {GSF} and {LDs} in Oslo-type experiments.},
	number = {{arXiv}:1609.00937},
	publisher = {{arXiv}},
	author = {Bassauer, S. and Neumann-Cosel, P. von and Tamii, A.},
	urldate = {2024-11-12},
	date = {2016-10-20},
	eprinttype = {arxiv},
	eprint = {1609.00937},
	keywords = {Nuclear Theory, Nuclear Experiment},
	file = {Preprint PDF:F\:\\zetoro\\storage\\8LF5F65Z\\Bassauer 等 - 2016 - Gamma strength function and level density of \$^ 208 \$Pb from forward-angle proton scattering at 295.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\9JMM4829\\1609.html:text/html},
}

