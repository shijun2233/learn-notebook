@article{hahn_cryogenic_2016,
	title = {The Cryogenic Storage Ring {CSR}},
	volume = {87},
	issn = {0034-6748, 1089-7623},
	url = {http://arxiv.org/abs/1606.01525},
	doi = {10.1063/1.4953888},
	abstract = {An electrostatic cryogenic storage ring, {CSR}, for beams of anions and cations with up to 300 {keV} kinetic energy per unit charge has been designed, constructed and put into operation. With a circumference of 35 m, the ion-beam vacuum chambers and all beam optics are in a cryostat and cooled by a closed-cycle liquid helium system. At temperatures as low as (5.5 \${\textbackslash}pm\$ 1) K inside the ring, storage time constants of several minutes up to almost an hour were observed for atomic and molecular, anion and cation beams at an energy of 60 {keV}. The ion-beam intensity, energy-dependent closed-orbit shifts (dispersion) and the focusing properties of the machine were studied by a system of capacitive pickups. The Schottky-noise spectrum of the stored ions revealed a broadening of the momentum distribution on a time scale of 1000 s. Photodetachment of stored anions was used in the beam lifetime measurements. The detachment rate by anion collisions with residual-gas molecules was found to be extremely low. A residual-gas density below 140 cm\${\textasciicircum}\{-3\}\$ is derived, equivalent to a room-temperature pressure below 10\${\textasciicircum}\{-14\}\$ mbar. Fast atomic, molecular and cluster ion beams stored for long periods of time in a cryogenic environment will allow experiments on collision- and radiation-induced fragmentation processes of ions in known internal quantum states with merged and crossed photon and particle beams.},
	pages = {063115},
	number = {6},
	journaltitle = {Review of Scientific Instruments},
	author = {Hahn, Robert von and Becker, Arno and Berg, Felix and Blaum, Klaus and Breitenfeldt, Christian and Fadil, Hisham and Fellenberger, Florian and Froese, Michael and George, Sebastian and Göck, Jürgen and Grieser, Manfred and Grussie, Florian and Guerin, Elisabeth A. and Heber, Oded and Herwig, Philipp and Karthein, Jonas and Krantz, Claude and Kreckel, Holger and Lange, Michael and Laux, Felix and Lohmann, Svenja and Menk, Sebastian and Meyer, Christian and Mishra, Preeti M. and Novotný, Oldřich and Connor, Aodh P. O. and Orlov, Dmitry A. and Rappaport, Michael L. and Repnow, Roland and Saurabh, Sunny and Schippers, Stefan and Schröter, Claus Dieter and Schwalm, Dirk and Schweikhard, Lutz and Sieber, Thomas and Shornikov, Andrey and Spruck, Kaija and Kumar, Sudhakaran Sunil and Ullrich, Joachim and Urbain, Xavier and Vogel, Stephen and Wilhelm, Patrick and Wolf, Andreas and Zajfman, Daniel},
	urldate = {2025-03-05},
	date = {2016-06-01},
	eprinttype = {arxiv},
	eprint = {1606.01525 [physics]},
	keywords = {Physics - Accelerator Physics, Physics - Atomic and Molecular Clusters, Physics - Atomic Physics, Physics - Chemical Physics},
	file = {Full Text PDF:F\:\\zetoro\\storage\\A7I8IMN5\\Hahn 等 - 2016 - The Cryogenic Storage Ring CSR.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\LRDSIZWX\\1606.html:text/html},
