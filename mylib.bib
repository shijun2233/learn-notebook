	title = {Radiative Capture Reaction \$d(α,γ){\textasciicircum}\{6\}{\textbackslash}mathrm\{Li\} \$ in Cluster Effective Field Theory},
	url = {http://arxiv.org/abs/2412.12205},
	doi = {10.48550/arXiv.2412.12205},
	abstract = {In this study, we focus on the radiative capture process of the deuteron on alpha particle leading to the formation of \${\textasciicircum}6\{{\textbackslash}textrm\{Li\}\}\$ in the two-body formalism through the cluster effective field theory{\textasciitilde}({CEFT}). It was the primitive nuclear reaction to produce \$\{{\textasciicircum}6 {\textbackslash}textrm\{Li\}\}\$ in a few minutes after the Big Bang. In detail, we outline the calculation of the dominant \$E1\$ and \$E2\$ electromagnetic transition amplitudes of \$d({\textbackslash}alpha,{\textbackslash}gamma )\{{\textasciicircum}6{\textbackslash}textrm\{Li\}\}\$. Then, we obtain the astrophysical S-factor by fitting it to the experimental data. Finally, we compare the obtained {CEFT} results for the astrophysical S-factor with the other theoretical results.},
