@article{bellini_neutrino_2014,
	title = {Neutrino oscillations},
	volume = {2014},
	issn = {1687-7357, 1687-7365},
	url = {http://arxiv.org/abs/1310.7858},
	doi = {10.1155/2014/191960},
	abstract = {In the last decades, a very important breakthrough has been brought in the elementary particle physics by the discovery of the phenomenon of the neutrino oscillations, which has shown neutrino properties beyond the Standard Model. But a full understanding of the various aspects of the neutrino oscillations is far to be achieved. In this paper the theoretical background of the neutrino oscillation phenomenon is described, referring in particular to the paradigmatic models. Then the various techniques and detectors which studied neutrinos from different sources are discussed, starting from the pioneering ones up to the detectors still in operation and to those in preparation. The physics results are finally presented adopting the same research path which has crossed this long saga. The problems not yet fixed in this field are discussed, together with the perspectives of their solutions in the near future.},
	pages = {1--28},
	journaltitle = {Advances in High Energy Physics},
	shortjournal = {Advances in High Energy Physics},
	author = {Bellini, G. and Ludhova, L. and Ranucci, G. and Villante, F. L.},
	urldate = {2024-10-27},
	date = {2014},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {1310.7858 [hep-ph]},
	keywords = {High Energy Physics - Phenomenology},
	file = {Bellini 等 - 2014 - Neutrino oscillations.pdf:F\:\\zetoro\\storage\\Y395E74B\\Bellini 等 - 2014 - Neutrino oscillations.pdf:application/pdf},
}

