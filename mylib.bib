}

@misc{saha_proton_2024,
	title = {Proton induced reaction on \${\textasciicircum}\{108\}\$Cd for astrophysical p-process studies},
	url = {http://arxiv.org/abs/2411.01279},
	doi = {10.48550/arXiv.2411.01279},
	abstract = {The proton capture cross-section of the least abundant proton-rich stable isotope of cadmium, \${\textasciicircum}\{108\}\$Cd (abundance 0.89{\textbackslash}\%), has been measured near the Gamow window corresponding to a temperature range of 3-4 {GK}. The measurement of the \${\textasciicircum}\{108\}\$Cd(p,\${\textbackslash}gamma\$)\${\textasciicircum}\{109\}\$In reaction was carried out using the activation technique. The cross-section at the lowest energy point of 3T\$\_9\$, E\$\_p\$\${\textasciicircum}\{lab\}\$= 2.28 {MeV}, has been reported for the first time. The astrophysical S-factor was measured in the energy range relevant to the astrophysical p-process, between E\$\_p\$\${\textasciicircum}\{cm\}\$= 2.29 and 6.79 {MeV}. The experimental results have been compared with theoretical predictions of Hauser-Feshbach statistical model calculations using {TALYS}-1.96. A calculated proton-optical potential was implemented to achieve better fitting, with different combinations of available nuclear level densities ({NLDs}) and \${\textbackslash}gamma\$-ray strength functions in {TALYS}-1.96. The calculations provided satisfactory agreement with the experimental results. The reaction rate was calculated using the calculated potential in {TALYS}-1.96 and compared with the values provided in the {REACLIB} database.},
	number = {{arXiv}:2411.01279},
	publisher = {{arXiv}},
	author = {Saha, Sukhendu and Basak, Dipali and Bar, Tanmoy and Sahoo, Lalit Kumar and Datta, Jagannath and Dasgupta, Sandipan and Kinoshita, Norikazu and Basu, Chinmay},
	urldate = {2024-12-15},
