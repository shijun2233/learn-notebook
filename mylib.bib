@article{kannis_spin_2025,
	title = {Spin manipulation and nuclear polarization enhancement in particle beams with static magnetic fields},
	volume = {112},
	url = {https://link.aps.org/doi/10.1103/4nr6-xt7m},
	doi = {10.1103/4nr6-xt7m},
	abstract = {A theoretical study of spin dynamics in nonrelativistic particle beams with interacting angular momenta traversing static, spatially varying magnetic fields is presented. The computational framework evaluates sinusoidal magnetic field configurations, calculating key observables such as average spin projections and state populations during the interaction. It is demonstrated that such fields can effectively enhance nuclear polarization in partially, incoherently polarized hydrogen and deuterium atomic beams, as well as coherently rotationally state-selected hydrogen deuteride molecular beams. This enhancement is attributed to transitions induced within the hyperfine regime of these systems. The study spans frequency ranges from gigahertz scales for atoms to hundreds of kilohertz for molecules, corresponding to magnetic field variations on spatial scales from submillimeters to meters.},
	pages = {012801},
	number = {1},
	journaltitle = {Physical Review A},
	shortjournal = {Phys. Rev. A},
	publisher = {American Physical Society},
	author = {Kannis, C. S. and Engels, R. and El-Kordy, T. and Faatz, N. and Pütz, S. J. and Verhoeven, V. and Rakitzis, T. P. and Büscher, M.},
	urldate = {2025-09-01},
	date = {2025-07-02},
	langid = {american},
	file = {APS Snapshot:F\:\\zetoro\\storage\\WDABBBL4\\4nr6-xt7m.html:text/html;Kannis 等 - 2025 - Spin manipulation and nuclear polarization enhancement in particle beams with static magnetic fields.pdf:F\:\\zetoro\\storage\\QHWQNYUP\\Kannis 等 - 2025 - Spin manipulation and nuclear polarization enhancement in particle beams with static magnetic fields.pdf:application/pdf},
}

@misc{dyatlov_classical_2025,
	title = {Classical and quantum beam dynamics simulation of the {RF} photoinjector test bench at {JINR}},
	url = {http://arxiv.org/abs/2509.00732},
	doi = {10.48550/arXiv.2509.00732},
	abstract = {We present simulation of the classical and quantum beam dynamics of an {RF} photoinjector test bench under development at Joint Institute for Nuclear Research. A 0.63 {pC} electron bunch is driven from a copper photocathode by a 262 nm ultraviolet laser and accelerated to energies of a few {MeV} in a 2856 {MHz}, 1.5-cell {RF} gun. Using realistic electromagnetic field maps and the {ASTRA} particle-tracking code, we optimize a Carlsten-style emittance-compensation solenoid to achieve a normalized transverse emittance of 3.2 pi mm mrad downstream of the gun. We also simulate the dynamic of a single-electron Laguerre-Gaussian wave packet carrying l = hbar orbital angular momentum projection in the same {RF} fields: continuous acceleration reduces its de Broglie wavelength and suppresses transverse spreading by a factor of six compared to free-space propagation over 30 cm. These results confirm the injector design, demonstrate the feasibility of the proposed emittance-compensation scheme, and pave the way to the first experimental demonstration of relativistic vortex electron generation in the few {MeV} energy range.},
	number = {{arXiv}:2509.00732},
	publisher = {{arXiv}},
	author = {Dyatlov, A. S. and Afanasyev, A. V. and Kobets, V. V. and Levichev, A. E. and Nikiforov, D. A. and Nozdrin, M. A. and Sibiryakova, K. A. and Yunenko, K. E. and Karlovets, D. V.},
	urldate = {2025-09-05},
	date = {2025-08-31},
	langid = {american},
	eprinttype = {arxiv},
	eprint = {2509.00732 [physics]},
	keywords = {Physics - Accelerator Physics, Physics - Atomic Physics},
	file = {Dyatlov 等 - 2025 - Classical and quantum beam dynamics simulation of the RF photoinjector test bench at JINR.pdf:F\:\\zetoro\\storage\\J3GUP2SU\\Dyatlov 等 - 2025 - Classical and quantum beam dynamics simulation of the RF photoinjector test bench at JINR.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\M6ZKUP9A\\2509.html:text/html},
}

@misc{updike_is_2025,
	title = {Is there an exact magnetic-moment for charged particle motion in a homogeneous, time-dependent magnetic field?},
	url = {http://arxiv.org/abs/2509.03641},
	doi = {10.48550/arXiv.2509.03641},
	abstract = {The nonperturbative guiding-center model provides an exact alternative to full-orbit simulations of charged particle dynamics in situations where traditional guiding-center theory may fail. We demonstrate that the charged particle motion in a homogeneous, time-varying magnetic field is a solvable example of the nonperturbative guiding-center model. This entails showing that the exact magnetic moment of Qin and Davidson can be constructed to be asymptotic to the adiabatic invariant series of Kruskal. In contrast to the perturbative invariant, the exact invariant contains information about parametric resonances. These resonances destroy the conservation of the usual magnetic moment over very long times. This refutes some previous claims about the all-time invariance of the magnetic moment.},
	number = {{arXiv}:2509.03641},
	publisher = {{arXiv}},
	author = {Updike, Michael and Burby, Joshua},
	urldate = {2025-09-05},
	date = {2025-09-03},
	langid = {american},
	eprinttype = {arxiv},
	eprint = {2509.03641 [physics]},
	keywords = {Mathematical Physics, Mathematics - Mathematical Physics, Physics - Plasma Physics},
	file = {Snapshot:F\:\\zetoro\\storage\\V5EMLKAJ\\2509.html:text/html;Updike和Burby - 2025 - Is there an exact magnetic-moment for charged particle motion in a homogeneous, time-dependent magne.pdf:F\:\\zetoro\\storage\\YL7Y42UQ\\Updike和Burby - 2025 - Is there an exact magnetic-moment for charged particle motion in a homogeneous, time-dependent magne.pdf:application/pdf},
}

@misc{hunter_measured_2025,
