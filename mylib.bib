}

@article{robin_competition_2024,
	title = {Competition between allowed and first-forbidden \$β\$ decay in \$r\$-process waiting-point nuclei within a relativistic beyond-mean-field approach},
	volume = {110},
	issn = {2469-9985, 2469-9993},
	url = {http://arxiv.org/abs/2403.17115},
	doi = {10.1103/PhysRevC.110.065803},
	abstract = {We compute \${\textbackslash}beta\$-decay half-lives of isotonic nuclear chains located at neutron shell closures \$N=50\$, \$82\$, \$126\$ and \$184\$, which are of particular importance for the \$r\$-process nucleosynthesis, and study the role of first-forbidden transitions in a framework that includes complex nucleonic correlations beyond the quasiparticle random phase approximation. Such correlations are accounted for by coupling single nucleons to collective degrees of freedom (nuclear vibrations), and are found essential to reproduce available experimental \${\textbackslash}beta\$-decay rates and more precise many-body methods. We find that the nucleon-vibration correlations tend to decrease the probability of decay via first-forbidden transition near stability, as they enhance Gamow-Teller transitions at low energy. While in the lighter systems allowed transitions dominate, the decay of \$N=126\$ and \$N=184\$ nuclei is found to occur to a large extent via first-forbidden transitions, and in particular those induced by \$1{\textasciicircum}-\$ and \$0{\textasciicircum}-\$ operators. Overall the many-body method based on nucleon-vibration coupling provides an ideal framework for future large-scale calculations. Upcoming experimental measurements of \${\textbackslash}beta\$-decay rates in the \$N=126\$ region by radioactive-beam facilities will be crucial in order to validate the approach.},
	pages = {065803},
	number = {6},
	journaltitle = {Physical Review C},
	shortjournal = {Phys. Rev. C},
	author = {Robin, Caroline E. P. and Martínez-Pinedo, Gabriel},
	urldate = {2024-12-18},
	date = {2024-12-16},
	eprinttype = {arxiv},
	eprint = {2403.17115 [nucl-th]},
	keywords = {Nuclear Theory, Nuclear Experiment},
	file = {Preprint PDF:F\:\\zetoro\\storage\\MP3N8HR2\\Robin和Martínez-Pinedo - 2024 - Competition between allowed and first-forbidden \$β\$ decay in \$r\$-process waiting-point nuclei within.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\ZPRPQJFJ\\2403.html:text/html},
}

