@article{gentile_optically_2017-1,
	title = {Optically polarized \${\textasciicircum}3\$he},
	volume = {89},
	issn = {0034-6861, 1539-0756},
	url = {http://arxiv.org/abs/1612.04178},
	doi = {10.1103/RevModPhys.89.045004},
	abstract = {This article reviews the physics and technology of producing large quantities of highly spin-polarized, or hyperpolarized, \${\textasciicircum}3\$He nuclei using spin-exchange ({SEOP}) and metastability-exchange ({MEOP}) optical pumping, and surveys applications of polarized \${\textasciicircum}3\$He. Several recent developments are emphasized for each method. For {SEOP}, the use of spectrally narrowed lasers and Rb/K mixtures has substantially increased the achievable polarization and polarizing rate. {MEOP} in high magnetic fields has likewise significantly increased the pressure at which this method can be performed, and has led to the observation of a light-induced relaxation mechanism. In both methods the increased capabilities have led to more extensive study and modeling of the basic underlying physics. New unexplained dependences of relaxation on temperature and magnetic field have been discovered in {SEOP} cells. Applications of both methods are also reviewed, including targets for charged particle and photon beams, neutron spin filters, magnetic resonance imaging, and precision measurements.},
	pages = {045004},
	number = {4},
	journaltitle = {Reviews of Modern Physics},
	shortjournal = {Rev. Mod. Phys.},
	author = {Gentile, T. R. and Nacher, P. J. and Saam, B. and Walker, T. G.},
	urldate = {2025-10-24},
	date = {2017-12-11},
	eprinttype = {arxiv},
	eprint = {1612.04178 [physics]},
	keywords = {Physics - Atomic Physics, Nuclear Experiment, Physics - Instrumentation and Detectors, Physics - Medical Physics},
	file = {Gentile 等 - 2017 - Optically polarized \$^3\$he.pdf:F\:\\zetoro\\storage\\FAGPRM6V\\Gentile 等 - 2017 - Optically polarized \$^3\$he.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\G4RKE7ZH\\1612.html:text/html},
