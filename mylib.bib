	langid = {english},
	file = {Nikiel 等 - 2007 - Metastability exchange optical pumping of 3He at high pressure and high magnetic field for medical a.pdf:F\:\\zetoro\\storage\\R7W43NK7\\Nikiel 等 - 2007 - Metastability exchange optical pumping of 3He at high pressure and high magnetic field for medical a.pdf:application/pdf},
