	keywords = {Nuclear Theory},
	file = {Preprint PDF:F\:\\zetoro\\storage\\IHSISS3E\\Tursunov和Turakulov - 2024 - Study of the direct \$^ 16 rm O (p, γ)^ 17 rm F \$ astrophysical capture reaction within a potenti.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\ZWI8WQQ2\\2405.html:text/html},
}

@article{malik_astrophysics_2024,
	title = {Astrophysics and Nuclear Physics Informed Interactions in Dense Matter: Inclusion of {PSR} J0437-4715},
	volume = {110},
	issn = {2470-0010, 2470-0029},
	url = {http://arxiv.org/abs/2404.07936},
	doi = {10.1103/PhysRevD.110.043042},
	shorttitle = {Astrophysics and Nuclear Physics Informed Interactions in Dense Matter},
	abstract = {We investigate how vector-isoscalar and vector-isovector interactions can be determined within the density regime of neutron stars ({NSs}), while fulfilling nuclear and astrophysics constrains. We make use of the Chiral Mean Field ({CMF}) model, a {SU}(3) nonlinear realization of the sigma model within the mean-field approximation, for the first time within a Bayesian analysis framework. We show that neutron-matter \${\textbackslash}chi\${EFT} constraints at low density are only satisfied if the vector-isovector mixed interaction term is included, e.g., a \${\textbackslash}omega{\textasciicircum}2{\textbackslash}rho{\textasciicircum}2\$ term. We also show the behavior of the model with respect to the conformal limit. We demonstrate that the {CMF} model is able to predict a value for the parameter \$d\_c\$ related to the trace anomaly and its derivative takes values below 0.2 above four times saturation density within a hadronic version of the model that does not include hyperons or a phase transition to deconfined matter. We compare these effects with results from other (non-chiral) Relativistic Mean Field models to assess how different approaches to incorporating the same physical constraints affect predictions of {NS} properties and dense matter equations of state. We also include data from the gravitation wave event {GW}230529 detected by the {LIGO}-Virgo-Kagra collaboration and the most recent radius measurement of {PSR} J0437-4715 from the {NASA} {NICER} mission. Our analysis reveals that this new {NICER} measurement leads to an average reduction of approximately \${\textbackslash}sim 0.1\$ km radius in the posterior of the {NS} mass-radius relationship.},
	pages = {043042},
	number = {4},
	journaltitle = {Physical Review D},
	shortjournal = {Phys. Rev. D},
	author = {Malik, Tuhin and Dexheimer, Veronica and Providência, Constança},
	urldate = {2024-12-15},
	date = {2024-08-27},
	eprinttype = {arxiv},
	eprint = {2404.07936 [nucl-th]},
	keywords = {Nuclear Theory, Astrophysics - High Energy Astrophysical Phenomena, General Relativity and Quantum Cosmology, High Energy Physics - Phenomenology},
	file = {Preprint PDF:F\:\\zetoro\\storage\\9DJ4RBUE\\Malik 等 - 2024 - Astrophysics and Nuclear Physics Informed Interactions in Dense Matter Inclusion of PSR J0437-4715.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\YQDDD3WW\\2404.html:text/html},
}

@article{leong_neutrino_2024,
	title = {Neutrino mean free path in neutron stars in the presence of hyperons},
	volume = {110},
