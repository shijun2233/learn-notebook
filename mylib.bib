@article{anderle_electron-ion_2021,
	title = {Electron-ion collider in China},
	volume = {16},
	issn = {2095-0462, 2095-0470},
	url = {https://link.springer.com/10.1007/s11467-021-1062-0},
	doi = {10.1007/s11467-021-1062-0},
	abstract = {Lepton scattering is an established ideal tool for studying inner structure of small particles such as nucleons as well as nuclei. As a future high energy nuclear physics project, an Electron-ion collider in China ({EicC}) has been proposed. It will be constructed based on an upgraded heavy-ion accelerator, High Intensity heavy-ion Accelerator Facility ({HIAF}) which is currently under construction, together with a new electron ring. The proposed collider will provide highly polarized electrons (with a polarization of ∼80\%) and protons (with a polarization of ∼70\%) with variable center of mass energies from 15 to 20 {GeV} and the luminosity of (2–3) × 1033 cm−2 ·s−1. Polarized deuterons and Helium-3, as well as unpolarized ion beams from Carbon to Uranium, will be also available at the {EicC}. The main foci of the {EicC} will be precision measurements of the structure of the nucleon in the sea quark region, including 3D tomography of nucleon; the partonic structure of nuclei and the parton interaction with the nuclear environment; the exotic states, especially those with heavy flavor quark contents. In addition, issues fundamental to understanding the origin of mass could be addressed by measurements of heavy quarkonia near-threshold production at the {EicC}. In order to achieve the above-mentioned physics goals, a hermetical detector system will be constructed with cutting-edge technologies. This document is the result of collective contributions and valuable inputs from experts across the globe. The {EicC} physics program complements the ongoing scientific programs at the Jefferson Laboratory and the future {EIC} project in the United States. The success of this project will also advance both nuclear and particle physics as well as accelerator and detector technology in China.},
	pages = {64701},
	number = {6},
	journaltitle = {Frontiers of Physics},
	shortjournal = {Front. Phys.},
	author = {Anderle, Daniele P. and Bertone, Valerio and Cao, Xu and Chang, Lei and Chang, Ningbo and Chen, Gu and Chen, Xurong and Chen, Zhuojun and Cui, Zhufang and Dai, Lingyun and Deng, Weitian and Ding, Minghui and Feng, Xu and Gong, Chang and Gui, Longcheng and Guo, Feng-Kun and Han, Chengdong and He, Jun and Hou, Tie-Jiun and Huang, Hongxia and Huang, Yin and {KumeričKi}, {KrešImir} and Kaptari, L. P. and Li, Demin and Li, Hengne and Li, Minxiang and Li, Xueqian and Liang, Yutie and Liang, Zuotang and Liu, Chen and Liu, Chuan and Liu, Guoming and Liu, Jie and Liu, Liuming and Liu, Xiang and Liu, Tianbo and Luo, Xiaofeng and Lyu, Zhun and Ma, Boqiang and Ma, Fu and Ma, Jianping and Ma, Yugang and Mao, Lijun and Mezrag, Cédric and Moutarde, Hervé and Ping, Jialun and Qin, Sixue and Ren, Hang and Roberts, Craig D. and Rojo, Juan and Shen, Guodong and Shi, Chao and Song, Qintao and Sun, Hao and Sznajder, Paweł and Wang, Enke and Wang, Fan and Wang, Qian and Wang, Rong and Wang, Ruiru and Wang, Taofeng and Wang, Wei and Wang, Xiaoyu and Wang, Xiaoyun and Wu, Jiajun and Wu, Xinggang and Xia, Lei and Xiao, Bowen and Xiao, Guoqing and Xie, Ju-Jun and Xie, Yaping and Xing, Hongxi and Xu, Hushan and Xu, Nu and Xu, Shusheng and Yan, Mengshi and Yan, Wenbiao and Yan, Wencheng and Yan, Xinhu and Yang, Jiancheng and Yang, Yi-Bo and Yang, Zhi and Yao, Deliang and Ye, Zhihong and Yin, Peilin and Yuan, C.-P. and Zhan, Wenlong and Zhang, Jianhui and Zhang, Jinlong and Zhang, Pengming and Zhang, Yifei and Chang, Chao-Hsi and Zhang, Zhenyu and Zhao, Hongwei and Chao, Kuang-Ta and Zhao, Qiang and Zhao, Yuxiang and Zhao, Zhengguo and Zheng, Liang and Zhou, Jian and Zhou, Xiang and Zhou, Xiaorong and Zou, Bingsong and Zou, Liping},
