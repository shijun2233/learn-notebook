}

@misc{farooq_impact_2024,
	title = {Impact of the Brink Axel Hypothesis on Unique First Forbidden {\textbackslash}b\{eta\} transitions for r process nuclei},
	url = {http://arxiv.org/abs/2411.01436},
	doi = {10.48550/arXiv.2411.01436},
	abstract = {Key nuclear inputs for the astrophysical r process simulations are the weak interaction rates. Consequently, the accuracy of these inputs directly affects the reliability of nucleosynthesis modeling. Majority of the stellar rates, used in simulation studies, are calculated invoking the Brink Axel ({BA}) hypothesis. The {BA} hypothesis assumes that the strength functions of all parent excited states are the same as for the ground state, only shifted in energies. However, {BA} hypothesis has to be tested against microscopically calculated state by state rates. In this project we study the impact of the {BA} hypothesis on calculated stellar {\textbackslash}b\{eta\} decay and electron capture rates. Our investigation include both Unique First Forbidden (U1F) and allowed transitions for 106 neutron rich trans iron nuclei ([27, 77] less than equal to [Z, A] less than equal to [82, 208]). The calculations were performed using the deformed proton-neutron quasiparticle randomphase approximation (pn {QRPA}) model with a simple plus quadrupole separable and schematic interaction. Waiting-point and several key r process nuclei lie within the considered mass region of the nuclear chart.},
	number = {{arXiv}:2411.01436},
	publisher = {{arXiv}},
	author = {Farooq, Fakeha and Nabi, Jameel-Un and Shehzadi, Ramoona},
	urldate = {2024-11-14},
	date = {2024-11-03},
	eprinttype = {arxiv},
	eprint = {2411.01436},
	keywords = {Nuclear Theory, Astrophysics - Solar and Stellar Astrophysics},
	file = {Preprint PDF:F\:\\zetoro\\storage\\344FFNUV\\Farooq 等 - 2024 - Impact of the Brink Axel Hypothesis on Unique First Forbidden b eta transitions for r process nucl.pdf:application/pdf;qwe.pdf:F\:\\zetoro\\storage\\NISG5WSX\\2411.html:text/html},
}

