@article{suchanek_optical_2007,
	title = {Optical measurement of 3He nuclear polarization for metastable exchange optical pumping studies at high magnetic field},
	volume = {144},
	rights = {http://www.springer.com/tdm},
	issn = {1951-6355, 1951-6401},
	url = {http://link.springer.com/10.1140/epjst/e2007-00109-8},
	doi = {10.1140/epjst/e2007-00109-8},
	abstract = {An accurate optical method to measure the nuclear polarization of 3He atoms in the 11S ground state is described. The absorption of a weak, probe laser beam is used to measure the relative populations of two hyperﬁne sublevels of the 23S metastable state that are not addressed by the pumping laser beam. Since a common spin temperature between the ground and metastable states is established by metastable exchange collisions, the nuclear polarization can be derived from these absorption measurements. The method is highly sensitive, robust, and can be used to monitor the dynamics of optical pumping and relaxation processes without interfering with them. It was successfully implemented and tested in the 0.45–2.0 T magnetic ﬁeld range at the 3He gas pressure up to 67 mbar.},
	pages = {67--74},
	number = {1},
	journaltitle = {The European Physical Journal Special Topics},
	shortjournal = {Eur. Phys. J. Spec. Top.},
	author = {Suchanek, K. and Suchanek, M. and Nikiel, A. and Pałasz, T. and Abboud, M. and Sinatra, A. and Nacher, P.-J. and Tastevin, G. and Olejniczak, Z. and Dohnalik, T.},
	urldate = {2025-10-20},
