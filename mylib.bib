	eprinttype = {arxiv},
	eprint = {1611.01789},
	keywords = {Nuclear Experiment},
	file = {Preprint PDF:F\:\\zetoro\\storage\\N2NLQA6I\\Martin 等 - 2017 - Test of the Brink-Axel hypothesis for the pygmy dipole resonance.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\MQYJ6L33\\1611.html:text/html},
}

@misc{markova_comprehensive_2021-1,
	title = {Comprehensive test of the Brink-Axel hypothesis in the energy region of the pygmy dipole resonance},
	url = {http://arxiv.org/abs/2012.11956},
	doi = {10.48550/arXiv.2012.11956},
	abstract = {The validity of the Brink-Axel hypothesis, which is especially important for numerous astrophysical calculations, is addressed for 116,120,124Sn below the neutron separation energy by means of three independent experimental methods. The \${\textbackslash}gamma\$-ray strength functions ({GSFs}) extracted from primary \${\textbackslash}gamma\$-decay spectra following charged-particle reactions with the Oslo method and with the Shape method demonstrate excellent agreement with those deduced from forward-angle inelastic proton scattering at relativistic beam energies. In addition, the {GSFs} are shown to be independent of excitation energies and spins of the initial and final states. The results provide a critical test of the generalized Brink-Axel hypothesis in heavy nuclei, demonstrating its applicability in the energy region of the pygmy dipole resonance.},
	number = {{arXiv}:2012.11956},
	publisher = {{arXiv}},
	author = {Markova, M. and Neumann-Cosel, P. von and Larsen, A. C. and Bassauer, S. and Görgen, A. and Guttormsen, M. and Garrote, F. L. Bello and Berg, H. C. and Bjørøen, M. M. and Dahl-Jacobsen, T. and Eriksen, T. K. and Gjestvang, D. and Isaak, J. and Mbabane, M. and Paulsen, W. and Pedersen, L. G. and Pettersen, N. I. J. and Richter, A. and Sahin, E. and Scholz, P. and Siem, S. and Tveten, G. M. and Valsdottir, V. M. and Wiedeking, M. and Zeiser, F.},
	urldate = {2024-11-12},
