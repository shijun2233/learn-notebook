	keywords = {Nuclear Experiment, Physics - Computational Physics, Physics - Data Analysis, Statistics and Probability},
	file = {Preprint PDF:F\:\\zetoro\\storage\\379F6Q8Z\\Midtbø 等 - 2021 - A new software implementation of the Oslo method with rigorous statistical uncertainty propagation.pdf:application/pdf;Snapshot:F\:\\zetoro\\storage\\T4757XMV\\1904.html:text/html},
