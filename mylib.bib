}

@article{chu_design_2024,
	title = {Design of the gradient dipole magnet for {LLICTF}},
	volume = {2687},
	issn = {1742-6588, 1742-6596},
	url = {https://iopscience.iop.org/article/10.1088/1742-6596/2687/6/062005},
	doi = {10.1088/1742-6596/2687/6/062005},
	abstract = {The Lanzhou Light Ion Cancer Therapy Facility ({LLICTF}) is a compact medical accelerator currently under construction. It is designed to treat cancer using a 230 {MeV}, 30 {mA} 𝐻+ beam and a 85 {MeV}/u, 1 {mA} 3He2+ beam. The facility comprises two ion sources, a low-energy beam-transport ({LEBT}), a Radio Frequency Quadrupole ({RFQ}), a mediumenergy beam-transport ({MEBT}), and the main ring accelerating structure. Due to the presence of two ion sources, it is necessary to introduce a dipole magnet which is symmetrically focused as much as possible to meet the focusing requirements of the {LEBT} beam. Therefore, a gradient dipole magnet has been designed to achieve this symmetrical focusing. This paper discusses the theoretical and simulated symmetric focusing of the gradient dipole magnet. It also analyzes the effect of fringe fields and space charge. Additionally, the paper presents the results of the model design with {CST} and the multi-particle simulation results with {TraceWin}.},
	pages = {062005},
	number = {6},
	journaltitle = {Journal of Physics: Conference Series},
	shortjournal = {J. Phys.: Conf. Ser.},
	author = {Chu, Yimeng and Wang, Zhijun and Huang, Junren and Chen, Weilong and Xu, Zhenyu and Liang, Zehua and Sun, Kunxiang},
	urldate = {2026-02-02},
	date = {2024-01-01},
	langid = {english},
	file = {Chu 等 - 2024 - Design of the gradient dipole magnet for LLICTF.pdf:F\:\\zetoro\\storage\\WBPHA4HF\\Chu 等 - 2024 - Design of the gradient dipole magnet for LLICTF.pdf:application/pdf},
}

@thesis{luo__nodate,
	title = {质子照相诊断等离子体电磁场中散射影响的研究},
	abstract = {In laser-plasma physics, proton diagnostics has emerged as an effective approach for obtaining electromagnetic field information, typically relying on electromagnetic field deflection of proton beams to extract electromagnetic field information. However, in plasma-electromagnetic field coexistence regions, the additional deflection in proton beam caused by scattering often prevents independent extraction of electromagnetic field-induced deflection information from probe proton beams, thereby hindering accurate acquisition of valid electromagnetic field information. To understand the scattering effect in proton diagnostics and obtain precise information of desired electromagnetic fields under scattering, this study systematically investigates the scattering effects in proton diagnostics through theoretical analysis and numerical simulations.},
	type = {phdthesis},
	author = {Luo, Zhikun and Wang, Xiaofang},
	langid = {english},
	file = {PDF:F\:\\zetoro\\storage\\5Y8KK7GP\\Luo和Wang - 质子照相诊断等离子体电磁场中散射影响的研究.pdf:application/pdf},
}

