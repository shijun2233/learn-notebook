@article{tursunov_study_2024,
	title = {Study of the direct \${\textasciicircum}\{16\}\{{\textbackslash}rm O\}(p, γ){\textasciicircum}\{17\}\{{\textbackslash}rm F\}\$ astrophysical capture reaction within a potential model approach},
	volume = {1051},
